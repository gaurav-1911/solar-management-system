# ============================================================
# Solar Backend (Express) - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URL=mongodb://localhost:27017/solar_crm

# JWT - Access Token
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=1d

# JWT - Refresh Token
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRE=7d

# Client URL (used for password-reset links and email redirects)
CLIENT_URL=http://localhost:3000

# Frontend URL (used for quotation public-response links)
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Cloudinary (file/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed script defaults (optional)
# ADMIN_EMAIL=admin@solar.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin@123
