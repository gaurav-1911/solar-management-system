# ============================================================
# Solar Admin Panel - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# This is a Vite project, so only VITE_* vars are exposed to the client.
# Non-VITE vars (like REACT_APP_*) are injected via vite.config.js define.
# ============================================================

# API Configuration
# Backend API base URL used by axios and other HTTP clients.
VITE_API_URL=http://localhost:5000/api
VITE_API_URL=https://discount-cauterize-disbelief.ngrok-free.dev/api

# Alternate key used by vite.config.js define and some components.
# Both VITE_API_URL and REACT_APP_API_URL are supported for compatibility.
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_URL=https://discount-cauterize-disbelief.ngrok-free.dev/api